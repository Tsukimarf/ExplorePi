{
  "database": "pi_blockchain_explorer",
  "tables": {
    "ledgers": {
      "primary_key": "sequence",
      "fields": {
        "sequence": "bigint",
        "hash": "string(64)",
        "prev_hash": "string(64)",
        "closed_at": "timestamp",
        "tx_count": "integer"
      }
    },
    "accounts": {
      "primary_key": "account_id",
      "fields": {
        "account_id": "string(56)",
        "sequence_number": "bigint",
        "subentry_count": "integer",
        "created_at": "timestamp"
      }
    },
    "transactions": {
      "primary_key": "tx_hash",
      "foreign_keys": {
        "ledger_seq": "ledgers.sequence",
        "source_account": "accounts.account_id"
      },
      "fields": {
        "tx_hash": "string(64)",
        "ledger_seq": "bigint",
        "source_account": "string(56)",
        "fee_paid": "integer",
        "memo": "string|null",
        "result_code": "string(32)"
      }
    },
    "operations": {
      "primary_key": "id",
      "foreign_keys": {
        "tx_hash": "transactions.tx_hash",
        "source_account": "accounts.account_id"
      },
      "fields": {
        "id": "bigint",
        "tx_hash": "string(64)",
        "source_account": "string(56)",
        "type": "string(32)",
        "details": "object"
      }
    },
    "assets": {
      "primary_key": "asset_code",
      "fields": {
        "asset_code": "string(12)",
        "issuer": "string(56)|null",
        "type": "string(16)"
      }
    },
    "balances": {
      "primary_key": "id",
      "foreign_keys": {
        "account_id": "accounts.account_id",
        "asset_code": "assets.asset_code"
      },
      "fields": {
        "id": "bigint",
        "account_id": "string(56)",
        "asset_code": "string(12)",
        "amount": "decimal(20,7)"
      }
    }
  },
  "sample_data": {
    "ledgers": [
      {
        "sequence": 1000042,
        "hash": "9f1c2e8a4b7d3f0e5c6a1b2d3e4f5061728394a5b6c7d8e9f0a1b2c3d4e5f60",
        "prev_hash": "8e0b1d7943a6c2e4f5d091827364a5b6c7d8e9f0a1b2c3d4e5f60718293a4b5",
        "closed_at": "2026-09-14T08:15:00Z",
        "tx_count": 3
      }
    ],
    "accounts": [
      { "account_id": "GABC1234567890EXAMPLEACCOUNT0000000000000000000000000", "sequence_number": 55, "subentry_count": 1, "created_at": "2026-01-05T12:00:00Z" }
    ],
    "transactions": [
      {
        "tx_hash": "a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f9",
        "ledger_seq": 1000042,
        "source_account": "GABC1234567890EXAMPLEACCOUNT0000000000000000000000000",
        "fee_paid": 100,
        "memo": "payment",
        "result_code": "tx_success"
      }
    ],
    "operations": [
      {
        "id": 501,
        "tx_hash": "a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f9",
        "source_account": "GABC1234567890EXAMPLEACCOUNT0000000000000000000000000",
        "type": "payment",
        "details": { "destination": "GXYZ...", "amount": "12.5000000", "asset_code": "PI" }
      }
    ],
    "assets": [
      { "asset_code": "PI", "issuer": null, "type": "native" }
    ],
    "balances": [
      { "id": 1, "account_id": "GABC1234567890EXAMPLEACCOUNT0000000000000000000000000", "asset_code": "PI", "amount": "1000.0000000" }
    ]
  }
}
